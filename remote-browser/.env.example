# Required: the password you type on the login page.
PASSWORD=change-me

# Port/interface to listen on. Put a reverse proxy with HTTPS in front (see README).
HOST=0.0.0.0
PORT=3300

# Page opened the very first time (later, open tabs are restored from the last run).
START_URL=https://www.google.com

# Where the Chromium profile (cookies, logins, history) and saved tabs live.
# DATA_DIR=./data

# Path to Chromium/Chrome if it isn't auto-detected.
# CHROME_PATH=/usr/bin/chromium

# Stream quality (1-100). Lower = less bandwidth.
# JPEG_QUALITY=70

# Highest device-pixel-ratio a viewer may request with "Sharp (HiDPI) frames".
# MAX_DPR=2

# How long a login lasts, in days.
# SESSION_DAYS=30

# Set to 1 if Chromium fails to start because of sandboxing (always on when running as root).
# NO_SANDBOX=1

# Set AUTH=none only if something in front (Cloudflare Access, Authelia, Tailscale…) already handles login.
# AUTH=none
